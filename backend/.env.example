# Tarang Backend — Environment Configuration
# Copy this file to .env and fill in values as needed.
# Lines beginning with # are comments.

# ---------------------------------------------------------------------------
# INCOIS ERDDAP (optional override — defaults to public endpoint)
# ---------------------------------------------------------------------------
INCOIS_ERDDAP_BASE_URL=https://erddap.incois.gov.in/erddap

# ---------------------------------------------------------------------------
# Groq (required for M6 LLM synthesis and query parsing)
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Sarvam AI (required for M7 TTS output)
# ---------------------------------------------------------------------------
SARVAM_API_KEY=

# ---------------------------------------------------------------------------
# HTTP timeouts and thresholds
# ---------------------------------------------------------------------------
HTTP_TIMEOUT=15
PFZ_SEARCH_RADIUS_KM=150
CHL_PFZ_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# Cache TTLs (seconds)
# ---------------------------------------------------------------------------
CACHE_TTL_MARINE_S=1800
CACHE_TTL_HAZARD_S=1800
CACHE_TTL_PFZ_S=14400

# ---------------------------------------------------------------------------
# Milestone 5: Conversational memory settings
# ---------------------------------------------------------------------------
# How long (seconds) a previous turn's agent result can be reused without re-fetching
FOLLOWUP_CACHE_TTL_SECONDS=300
# Max conversation turns to keep in history
MAX_CONVERSATION_TURNS=6

# ---------------------------------------------------------------------------
# Twilio WhatsApp Configuration
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_RECIPIENT_PHONE=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
WHATSAPP_SESSION_TTL_SECONDS=600

GEOFENCE_WHATSAPP_COOLDOWN_SECONDS=300
